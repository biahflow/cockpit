POSTGRES_DB=biahflow
POSTGRES_USER=biahflow
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN=http://localhost:19173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:19173,http://127.0.0.1:19173
# O MinIO existe no compose de desenvolvimento mas o Django não o lê: está provisionado e não
# conectado (docs/architecture.md). Documento local vai para MEDIA_ROOT ou para o Google Drive.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=noreply@biahflow.local
# Notificações por e-mail + digest diário (Go-live/Hypercare). Ligado por padrão (ADR 0018);
# ponha `false` para silenciar. Também alternável em Configurações.
EMAIL_NOTIFICATIONS_ENABLED=true
# Portal do cliente (ADR 0003). Deixe vazio para desligar a integração — sem URL e secret a flag
# fica desligada mesmo que alguém tente ligá-la pela tela. Também alternável em Configurações.
PORTAL_WEBHOOK_URL=
PORTAL_WEBHOOK_SECRET=
PORTAL_READ_TOKEN=
# Google Drive como storage de documentos (deixe false para usar o storage local).
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Como o portal se autentica no Google (ADR 0016). NUNCA por chave de conta de serviço: ela é
# segredo de vida longa, e organizações a proíbem por política.
#   adc   (default) Application Default Credentials. Em container/pod, Workload Identity — sem
#                   segredo nenhum aqui. Localmente: gcloud auth application-default login.
#                   Se você tiver um arquivo de credencial (inclusive de Workload Identity
#                   Federation), aponte GOOGLE_APPLICATION_CREDENTIALS para ele.
#   oauth           Credencial de usuário por refresh token. Necessária para agir COMO UMA PESSOA,
#                   que é o que convidar participante em evento exige.
GOOGLE_AUTH_MODE=adc
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Captação de leads pelo site (formulário "Fale com um consultor").
# Gere um token forte e use o MESMO no snippet do site (header X-Intake-Token).
LEAD_INTAKE_TOKEN=
# Origem(ns) do site que pode(m) postar no intake, separadas por vírgula:
CORS_ALLOWED_ORIGINS=
# IA (OpenAI). Deixe AI_ENABLED=false até ter a chave. Ligue com sua OPENAI_API_KEY.
AI_ENABLED=false
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
# Endpoint alternativo compatível com a API da OpenAI (vazio = a própria OpenAI) e teto de
# chamadas de IA por usuário por dia.
AI_BASE_URL=
AI_DAILY_LIMIT=50
# Teto de cada chamada ao modelo. O SDK espera 10 min por padrão, e uma dessas chamadas roda dentro
# do POST público do formulário de leads — sem teto, um dia ruim da OpenAI prende o worker.
AI_TIMEOUT_SECONDS=30
# Retenção de dado pessoal arquivado (LGPD, ADR 0017). ZERO = NUNCA EXPURGAR, e é o default.
# O prazo é decisão de negócio; o portal só entrega o mecanismo. Confira com
# `manage.py purge_archived` (ensaia) antes de `--apply` (apaga de verdade).
RETENTION_LEAD_DAYS=0
RETENTION_DOCUMENT_DAYS=0
# Calendário Google e assinatura eletrônica (esqueletos; ligue quando tiver conta/fornecedor).
CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=
# Agendamento (booking) por leads qualificados: calendário dedicado às reservas (default: o mesmo
# de GOOGLE_CALENDAR_ID), corte de fit (high|medium|low) e duração do slot em minutos. Requer AI_ENABLED.
GOOGLE_BOOKING_CALENDAR_ID=
BOOKING_MIN_FIT=medium
BOOKING_SLOT_MINUTES=45
# Assinatura eletrônica: fornecedor em uso é o Autentique (`autentique`; `clicksign` também
# tem adaptador). ESIGN_WEBHOOK_SECRET é o segredo do HMAC cadastrado no painel do fornecedor;
# sem ele o webhook nega (401). ESIGN_API_BASE vazio = URL padrão do adaptador escolhido.
# ESIGN_SANDBOX=true cria documentos de teste (sem crédito, apagados em poucos dias).
# Ligado por padrão (ADR 0018), mas inerte enquanto faltar PROVIDER, TOKEN ou WEBHOOK_SECRET:
# sem as três a flag fica desligada e as ações de assinatura seguem respondendo 503.
ESIGN_ENABLED=true
ESIGN_PROVIDER=autentique
ESIGN_API_TOKEN=
ESIGN_API_BASE=
ESIGN_SANDBOX=true
# Quem avisa o signatário: "email" (o fornecedor manda o convite oficial; o portal não recebe
# link) ou "link" (o fornecedor devolve o link de assinatura e o portal entrega por e-mail).
ESIGN_DELIVERY=email
ESIGN_WEBHOOK_SECRET=
# O e-mail com que a casa assina (ADR 0065). Preenchido, o Pulse acrescenta um signatário `house`
# a toda rodada — quem envia não digita o próprio e-mail toda vez. Vazio (padrão) = a rodada tem
# exatamente os signatários que o pedido nomeou.
ESIGN_HOUSE_SIGNER_EMAIL=

# Gateway de pagamento (FDD 028). Ligado por padrão e **sem provedor** por padrão, o que significa
# registro local: a fatura vive só no portal e "marcar como paga" é o único caminho de baixa — modo
# previsto, não degradado. Nomeie PAYMENTS_PROVIDER=stripe para valer com fornecedor; aí
# PAYMENTS_API_TOKEN e PAYMENTS_WEBHOOK_SECRET viram obrigatórios (sem o segredo, o webhook nega com
# 401 e a fatura nunca fecha sozinha). O webhook é `POST /api/v1/payments/webhook/`.
# **O Stripe ainda não foi homologado** — ver docs/runbooks/homologacao-de-integracoes.md.
PAYMENTS_ENABLED=true
PAYMENTS_PROVIDER=
PAYMENTS_API_TOKEN=
PAYMENTS_API_BASE=
PAYMENTS_WEBHOOK_SECRET=
# Janela de aceitação do carimbo do webhook, em segundos. É o que faz uma entrega capturada parar
# de valer; sem ela, um corpo assinado hoje seria reproduzível para sempre.
# PAYMENTS_WEBHOOK_TOLERANCE_SECONDS=300

# Mensagens por WhatsApp (ADR 0031, ADR 0062, ADR 0064). **WhatsApp carrega coordenação; o One
# carrega conteúdo** — achado, decisão, custo apurado e entregável atravessam pelo One, atrás da
# marca de publicável, e mandá-los por aqui contornaria o gate de revisão humana.
#
# **Nasce desligada.** Desde a issue #110 há chamador — o kickoff abre o grupo do cliente ao nascer
# o projeto —, e é por isso que ligar é ato de operação, não de deploy: ligada, a primeira conversão
# cria grupo de verdade, com um número não oficial que fala com clientes.
#
# WHATSAPP_PROVIDERS é uma **lista ordenada**, e não um provedor só como ESIGN/PAYMENTS: o segundo
# nome não é a alternativa da instalação, é o fallback da primeira. "zapi,uazapi" tenta na ordem
# escrita. Vazio significa NullProvider — registra a intenção e não manda nada —, e nesse modo
# nenhuma credencial é cobrada. Nomeado um provedor, as credenciais **dele** viram obrigatórias.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDERS=
# Z-API: instância e token vão na URL. O CLIENT_TOKEN é a validação por token da **conta**, que só
# existe se quem administra a ligou no painel — por isso não é obrigatório. API_BASE vazio = a URL
# padrão do adaptador.
WHATSAPP_ZAPI_INSTANCE_ID=
WHATSAPP_ZAPI_TOKEN=
WHATSAPP_ZAPI_CLIENT_TOKEN=
WHATSAPP_ZAPI_API_BASE=
# UAZAPI: token no header, e a base muda por instância (https://{subdomínio}.uazapi.com).
WHATSAPP_UAZAPI_TOKEN=
WHATSAPP_UAZAPI_API_BASE=
# Teto de espera por provedor, em segundos. Importa mais aqui do que nas outras integrações: passar
# do teto produz UNCERTAIN, que por decisão **não** cai para o próximo provedor — curto demais
# transforma entrega lenta em mensagem não enviada, longo demais segura quem chamou.
# WHATSAPP_TIMEOUT_SECONDS=15
# Teto próprio da criação de grupo (ADR 0064). Mandar texto é falar com o provedor; criar grupo é o
# provedor falando com a rede do WhatsApp e esperando o grupo existir — outra ordem de grandeza.
# Mediu-se que 15s é curto (o grupo nasceu e a resposta não voltou, 03/09/2026); **não** se mediu
# quanto a UAZAPI leva de fato, então 90 é folga escolhida, não número apurado.
# WHATSAPP_GROUP_TIMEOUT_SECONDS=90

# Enriquecimento de lead (FDD 030): cadastro público de CNPJ alimentando a qualificação que já
# existe — setor (CNAE), porte, capital social, situação cadastral e praça entram no **mesmo**
# contexto do `ai_fit`, e o CNAE preenche a vertical do cliente na conversão quando o admin já
# cadastrou aquela vertical.
#
# **Desligado por padrão**, e não pela razão de sempre: o provedor default (BrasilAPI) é gratuito e
# não pede credencial, então não há custo por chamada a evitar. A razão é que isto manda o CNPJ
# digitado no formulário público para um terceiro — decisão de fluxo de dado que a instalação toma
# de propósito, e não um default que ela descobre depois. Ligue com ENRICHMENT_ENABLED=true.
#
# Sem credencial nenhuma a cobrar: `configured()` passa sempre, e quem responde "isto funciona?" é
# `manage.py check_integrations`. Falha do fornecedor **nunca** bloqueia o lead nem a qualificação.
ENRICHMENT_ENABLED=false
ENRICHMENT_PROVIDER=brasilapi
ENRICHMENT_API_BASE=
# Teto apertado de propósito: roda dentro do POST público do formulário, antes da qualificação.
# ENRICHMENT_TIMEOUT_SECONDS=5

# Base de conhecimento interna (FDD 029, ADR 0022/0023). Segue a flag `ai` — mesma credencial, sem
# variável própria de liga/desliga. O **inventário de frescor funciona sem IA nenhuma**; só a
# recuperação com citação precisa da chave. Popular com `manage.py ingest_knowledge`.
# A **dimensão do vetor não é configurável**: ela é assada na migração (1536). Trocar o modelo por
# um de outra dimensão exige migração, não variável de ambiente.
# AI_EMBEDDING_MODEL=text-embedding-3-small
# Piso de similaridade para injetar material. **Não decide correção** — quem declara de onde veio a
# resposta é o modelo (ADR 0023). Medido na rodada 5: metodologia 51-69%, operacional 47-56%, ruído
# 22-49%. Serve só para não gastar token com material fora do assunto.
# KB_MIN_SIMILARITY_PERCENT=45
# KB_TOP_K=6
# Sincronia de tarefas com Linear/GitHub (ADR 0004). TASKSYNC_TOKEN é o segredo do header
# X-Sync-Token no webhook de entrada; os state IDs saem do workspace do Linear.
TASKSYNC_ENABLED=false
TASKSYNC_TOKEN=
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_STATE_TODO=
LINEAR_STATE_IN_PROGRESS=
LINEAR_STATE_DONE=
GITHUB_TOKEN=
GITHUB_REPO=
# Provisionamento de Issue de engenharia (FDD 040, ADR 0040). Distinto de TASKSYNC_*.
# GITHUB_PROVISIONING_ENABLED=false
# Teto de requisições (FDD 017, ADR 0009). Os defaults do código estão abaixo — descomente só o
# que precisar afrouxar. ANON_RATE/USER_RATE valem para toda a API; os demais são por rota.
# ANON_RATE=60/min
# USER_RATE=2000/hour
# LOGIN_RATE=10/min
# INVITATION_ACCEPT_RATE=20/hour
# PORTAL_READ_RATE=120/hour
# LEAD_INTAKE_RATE=20/hour
# TASK_SYNC_RATE=60/hour
# BOOKING_RATE=60/hour
# ESIGN_WEBHOOK_RATE=120/hour
# Cinco vezes o teto do e-sign: o Stripe trata 429 como falha e faz backoff por dias, e cada
# pagamento chega em dois eventos (invoice.paid + invoice.payment_succeeded).
# PAYMENTS_WEBHOOK_RATE=600/hour
# Quantos proxies confiáveis existem na frente do Django. Sem isso, o limite por IP agrupa todo
# mundo que vem pelo mesmo proxy (é o que acontece no compose, onde o SPA fala com a API pelo
# container do Vite). Em produção, ponha o número de proxies do seu ingress.
# NUM_PROXIES=1

# ============================================================================
# Produção (FDD 019, ADR 0011)
# ============================================================================
# Comentado de propósito: com estas linhas ativas o ambiente de desenvolvimento para de funcionar
# (o redirect para https, principalmente). O `docker-compose.prod.yml` já liga o essencial sozinho;
# o que está aqui é para quem sobe fora do compose. Passo a passo: docs/runbooks/producao.md.
#
# Nenhum default do código liga transporte seguro, e isso é deliberado: `DJANGO_DEBUG=false` também
# é o modo da suíte de testes, então derivar de DEBUG deixaria a suíte inteira em 301. Quem cobra
# que isto esteja ligado em produção é `manage.py check --deploy --tag security`.

# Segredo da instalação. Gere com:
#   python -c 'import secrets; print(secrets.token_urlsafe(64))'
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=portal.suaempresa.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.suaempresa.com
# FRONTEND_ORIGIN=https://portal.suaempresa.com

# Banco. Sem DATABASE_URL o portal cai no SQLite — que em container é arquivo efêmero, e um check
# de deploy recusa subir assim. `DB_SSLMODE` vence o `?sslmode=` da própria URL.
# DATABASE_URL=postgresql://usuario:senha@host:5432/biahflow
# DB_SSLMODE=require
# DB_CONN_MAX_AGE=60

# Cache compartilhado. Sem ele o teto de requisição da ADR 0009 vale N vezes o configurado, onde N
# é o número de workers do gunicorn. Também recusado pelo check de deploy.
# REDIS_URL=redis://redis:6379/0

# Transporte. HSTS entra por etapas (max-age curto primeiro) e PRELOAD é quase irreversível: só
# ligue no fim, e ciente de que sair da lista leva meses. Ver o runbook.
# DJANGO_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_HSTS_PRELOAD=false
# Rotas isentas do redirect, por regex e sem a barra inicial (sonda de balanceador que só fala http).
# DJANGO_SSL_REDIRECT_EXEMPT=

# Confiar no X-Forwarded-Proto do proxy. Ligue **somente** se todo caminho até o gunicorn passa por
# um proxy que sobrescreve esse header. Se a porta do container for alcançável direto, qualquer
# cliente manda "X-Forwarded-Proto: https" e derruba o redirect e a premissa do cookie Secure.
# TRUST_X_FORWARDED_PROTO=true

# Sessão: expiração deslizante por inatividade, em segundos (default 12h).
# SESSION_COOKIE_AGE=43200

# Onde ficam os arquivos. Documento de cliente precisa de volume próprio — dentro da árvore de
# código, um deploy leva tudo embora.
# DJANGO_MEDIA_ROOT=/var/lib/biahflow/media
# DJANGO_STATIC_ROOT=/app/staticfiles

# Documento no Cloud Storage em vez do sistema de arquivos (FDD 017). Preenchida, o
# `STORAGES["default"]` passa a ser o bucket; vazia, continua o disco — que é o compose, onde
# há volume. **Num ambiente sem volume durável, como o Cloud Run, deixar vazia significa que o
# arquivo morre na revisão seguinte.** A credencial vem do ADC (metadata server ou
# `gcloud auth application-default login`), nunca de chave de conta de serviço (ADR 0016).
# GCS_MEDIA_BUCKET=meu-projeto-midia

# SMTP de verdade (o Mailpit é só de desenvolvimento).
# EMAIL_HOST=smtp.suaempresa.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=portal@suaempresa.com

# Processo e porta publicada pelo nginx do SPA (o TLS termina antes dele).
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=60
# WEB_PORT=8080

# ============================================================================
# Monitoramento (FDD 020, ADR 0012)
# ============================================================================
# Sondas: GET /healthz (vivo, não toca em nada) e GET /readyz (pronto: banco + cache, 503 quando
# algum falha). Aponte a sonda de reinício do orquestrador para /healthz e a do balanceador para
# /readyz — trocar as duas faz o orquestrador reiniciar o container toda vez que o banco cai.
# Elas não são contrato de API: ficam fora de /api/v1/, sem sessão e sem teto de requisição.

# Log. O `docker-compose.prod.yml` já põe json; texto é o default, para o terminal de quem
# desenvolve. O request-id sai em toda linha nos dois formatos.
# DJANGO_LOG_FORMAT=json
# DJANGO_LOG_LEVEL=INFO
# Desliga o log de acesso da aplicação (o do gunicorn continua). Só faça isso se já coletar
# outro — este é o único que sabe o usuário e a duração de cada requisição.
# DJANGO_LOG_REQUESTS=true

# Rastreamento de erro (Sentry). Vazio = desligado, e nada é enviado a lugar nenhum. O DSN é
# público por desenho (identifica o projeto e só aceita escrita); PII nunca é enviada.
# SENTRY_DSN=https://chave@o0.ingest.sentry.io/1234567
# SENTRY_ENVIRONMENT=producao
# SENTRY_RELEASE=2026.08.05
# Amostragem de performance. 0 = só erro, que é o que este item precisa.
# SENTRY_TRACES_SAMPLE_RATE=0
# O SPA é estático: o DSN dele é assado no **build** da imagem do `web` (build arg), não lido em
# runtime. Trocar exige `up -d --build web`. Deixe vazio para não instrumentar o browser.
# VITE_SENTRY_DSN=https://chave@o0.ingest.sentry.io/1234567

# ============================================================================
# Backup (FDD 021, ADR 0013)
# ============================================================================
# O sidecar `backup` do docker-compose.prod.yml sobe junto com a stack e roda sozinho: quem faz
# `up -d` já tem backup, sem passo manual. Nada aqui é obrigatório — os defaults abaixo são os do
# compose. Restauração e teste de mesa: docs/runbooks/backup-e-restauracao.md.

# Quando rodar (crontab de 5 campos, no fuso do container) e por quantos dias guardar. 0 desliga a
# poda. A poda só roda depois de uma cópia nova bem-sucedida, e nunca apaga a última que restou.
# BACKUP_CRON=15 3 * * *
# BACKUP_RETENTION_DAYS=14
# TZ=America/Sao_Paulo

# Idade máxima antes de o `manage.py backup_status` reprovar (26 h dá folga sobre o backup
# diário). É o comando que o alerta chama — ver docs/runbooks/monitoramento.md.
# BACKUP_MAX_AGE_HOURS=26

# Agendador de trabalho periódico (FDD 023, ADR 0015)
# ---------------------------------------------------
# Quem roda é o serviço `scheduler` do compose de produção — o mesmo container da API, outro
# processo. Ele dispara o digest diário (FDD 010), a sincronia de calendário (FDD 012) e a
# conferência de backup (FDD 021); antes da FDD 023 os três dependiam de um cron que não existia
# em lugar nenhum, e por isso nenhum deles rodava.
#
# Horários em hora de parede de TIME_ZONE (America/Sao_Paulo), não no TZ do container.
# SCHEDULER_TICK_SECONDS=60
# SCHEDULER_DIGEST_AT=07:30
# SCHEDULER_CALENDAR_EVERY_MINUTES=15
# SCHEDULER_BACKUP_CHECK_AT=09:00
# Antes do digest das 07:30: quem lê o dia precisa achar o vencimento apurado, não a apurar.
# SCHEDULER_INVOICES_AT=06:00
# Também antes do digest: fecha a reserva e a reunião cujo horário já passou. Sem este job elas
# ficam "agendadas" para sempre, e o resumo anuncia como marcada a sessão de ontem.
# SCHEDULER_SESSIONS_AT=06:30
# Depois do digest, para não competir por atenção, e em horário comercial: quem age sobre
# conhecimento vencido é gente.
# SCHEDULER_KNOWLEDGE_AT=08:00

# Offsite (opcional, e a diferença entre ter backup e ter uma cópia que morre junto com o host).
# Qualquer storage compatível com S3: AWS, Backblaze B2, Cloudflare R2, MinIO. Deixe o bucket
# vazio para ficar só no volume local.
#
# Use uma credencial **só deste bucket**, com permissão de escrita e leitura e sem poder apagar
# versão antiga — e ligue versionamento + regra de ciclo de vida no bucket. O dump é o banco
# inteiro em claro: quem lê o bucket lê a base de clientes.
# BACKUP_S3_BUCKET=biahflow-backups
# BACKUP_S3_PREFIX=producao
# BACKUP_S3_ENDPOINT=            # vazio = AWS S3; preencha para B2/R2/MinIO
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_PROVIDER=Other       # AWS, Ceph, Minio, Cloudflare... (nomes do rclone)
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=

