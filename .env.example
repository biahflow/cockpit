POSTGRES_DB=biahflow
POSTGRES_USER=biahflow
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN=http://localhost:19173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:19173,http://127.0.0.1:19173
# O MinIO existe no compose de desenvolvimento mas o Django não o lê: está provisionado e não
# conectado (docs/architecture.md). Documento local vai para MEDIA_ROOT ou para o Google Drive.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=noreply@biahflow.local
# Notificações por e-mail + digest diário (Go-live/Hypercare). Também alternável em Configurações.
EMAIL_NOTIFICATIONS_ENABLED=false
# Portal do cliente (ADR 0003). Deixe vazio para desligar a integração.
PORTAL_WEBHOOK_URL=
PORTAL_WEBHOOK_SECRET=
PORTAL_READ_TOKEN=
# Google Drive como storage de documentos (deixe false para usar o storage local).
GOOGLE_DRIVE_ENABLED=false
# Cole o JSON da conta de serviço (uma linha) e o ID do Shared Drive/pasta raiz.
# Como alternativa ao JSON inline, GOOGLE_SERVICE_ACCOUNT_FILE aponta para o arquivo montado.
GOOGLE_SERVICE_ACCOUNT_INFO=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Captação de leads pelo site (formulário "Fale com um consultor").
# Gere um token forte e use o MESMO no snippet do site (header X-Intake-Token).
LEAD_INTAKE_TOKEN=
# Origem(ns) do site que pode(m) postar no intake, separadas por vírgula:
CORS_ALLOWED_ORIGINS=
# IA (OpenAI). Deixe AI_ENABLED=false até ter a chave. Ligue com sua OPENAI_API_KEY.
AI_ENABLED=false
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
# Endpoint alternativo compatível com a API da OpenAI (vazio = a própria OpenAI) e teto de
# chamadas de IA por usuário por dia.
AI_BASE_URL=
AI_DAILY_LIMIT=50
# Calendário Google e assinatura eletrônica (esqueletos; ligue quando tiver conta/fornecedor).
CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=
# Agendamento (booking) por leads qualificados: calendário dedicado às reservas (default: o mesmo
# de GOOGLE_CALENDAR_ID), corte de fit (high|medium|low) e duração do slot em minutos. Requer AI_ENABLED.
GOOGLE_BOOKING_CALENDAR_ID=
BOOKING_MIN_FIT=medium
BOOKING_SLOT_MINUTES=45
# Assinatura eletrônica: fornecedor em uso é o Autentique (`autentique`; `clicksign` também
# tem adaptador). ESIGN_WEBHOOK_SECRET é o segredo do HMAC cadastrado no painel do fornecedor;
# sem ele o webhook nega (401). ESIGN_API_BASE vazio = URL padrão do adaptador escolhido.
# ESIGN_SANDBOX=true cria documentos de teste (sem crédito, apagados em poucos dias).
ESIGN_ENABLED=false
ESIGN_PROVIDER=autentique
ESIGN_API_TOKEN=
ESIGN_API_BASE=
ESIGN_SANDBOX=true
# Quem avisa o signatário: "email" (o fornecedor manda o convite oficial; o portal não recebe
# link) ou "link" (o fornecedor devolve o link de assinatura e o portal entrega por e-mail).
ESIGN_DELIVERY=email
ESIGN_WEBHOOK_SECRET=
# Sincronia de tarefas com Linear/GitHub (ADR 0004). TASKSYNC_TOKEN é o segredo do header
# X-Sync-Token no webhook de entrada; os state IDs saem do workspace do Linear.
TASKSYNC_ENABLED=false
TASKSYNC_TOKEN=
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_STATE_TODO=
LINEAR_STATE_IN_PROGRESS=
LINEAR_STATE_DONE=
GITHUB_TOKEN=
GITHUB_REPO=
# Teto de requisições (FDD 017, ADR 0009). Os defaults do código estão abaixo — descomente só o
# que precisar afrouxar. ANON_RATE/USER_RATE valem para toda a API; os demais são por rota.
# ANON_RATE=60/min
# USER_RATE=2000/hour
# LOGIN_RATE=10/min
# INVITATION_ACCEPT_RATE=20/hour
# PORTAL_READ_RATE=120/hour
# LEAD_INTAKE_RATE=20/hour
# TASK_SYNC_RATE=60/hour
# BOOKING_RATE=60/hour
# ESIGN_WEBHOOK_RATE=120/hour
# Quantos proxies confiáveis existem na frente do Django. Sem isso, o limite por IP agrupa todo
# mundo que vem pelo mesmo proxy (é o que acontece no compose, onde o SPA fala com a API pelo
# container do Vite). Em produção, ponha o número de proxies do seu ingress.
# NUM_PROXIES=1

# ============================================================================
# Produção (FDD 019, ADR 0011)
# ============================================================================
# Comentado de propósito: com estas linhas ativas o ambiente de desenvolvimento para de funcionar
# (o redirect para https, principalmente). O `docker-compose.prod.yml` já liga o essencial sozinho;
# o que está aqui é para quem sobe fora do compose. Passo a passo: docs/runbooks/producao.md.
#
# Nenhum default do código liga transporte seguro, e isso é deliberado: `DJANGO_DEBUG=false` também
# é o modo da suíte de testes, então derivar de DEBUG deixaria a suíte inteira em 301. Quem cobra
# que isto esteja ligado em produção é `manage.py check --deploy --tag security`.

# Segredo da instalação. Gere com:
#   python -c 'import secrets; print(secrets.token_urlsafe(64))'
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=portal.suaempresa.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.suaempresa.com
# FRONTEND_ORIGIN=https://portal.suaempresa.com

# Banco. Sem DATABASE_URL o portal cai no SQLite — que em container é arquivo efêmero, e um check
# de deploy recusa subir assim. `DB_SSLMODE` vence o `?sslmode=` da própria URL.
# DATABASE_URL=postgresql://usuario:senha@host:5432/biahflow
# DB_SSLMODE=require
# DB_CONN_MAX_AGE=60

# Cache compartilhado. Sem ele o teto de requisição da ADR 0009 vale N vezes o configurado, onde N
# é o número de workers do gunicorn. Também recusado pelo check de deploy.
# REDIS_URL=redis://redis:6379/0

# Transporte. HSTS entra por etapas (max-age curto primeiro) e PRELOAD é quase irreversível: só
# ligue no fim, e ciente de que sair da lista leva meses. Ver o runbook.
# DJANGO_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_HSTS_PRELOAD=false
# Rotas isentas do redirect, por regex e sem a barra inicial (sonda de balanceador que só fala http).
# DJANGO_SSL_REDIRECT_EXEMPT=

# Confiar no X-Forwarded-Proto do proxy. Ligue **somente** se todo caminho até o gunicorn passa por
# um proxy que sobrescreve esse header. Se a porta do container for alcançável direto, qualquer
# cliente manda "X-Forwarded-Proto: https" e derruba o redirect e a premissa do cookie Secure.
# TRUST_X_FORWARDED_PROTO=true

# Sessão: expiração deslizante por inatividade, em segundos (default 12h).
# SESSION_COOKIE_AGE=43200

# Onde ficam os arquivos. Documento de cliente precisa de volume próprio — dentro da árvore de
# código, um deploy leva tudo embora.
# DJANGO_MEDIA_ROOT=/var/lib/biahflow/media
# DJANGO_STATIC_ROOT=/app/staticfiles

# SMTP de verdade (o Mailpit é só de desenvolvimento).
# EMAIL_HOST=smtp.suaempresa.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=portal@suaempresa.com

# Processo e porta publicada pelo nginx do SPA (o TLS termina antes dele).
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=60
# WEB_PORT=8080
# DJANGO_LOG_LEVEL=INFO

