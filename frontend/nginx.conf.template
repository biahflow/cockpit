# nginx do SPA em produção (FDD 019). É a borda **da aplicação**, não o terminador de TLS: quem
# termina o TLS é o proxy do provedor, na frente deste. Este arquivo entra em `conf.d/`, que o
# nginx inclui dentro do bloco `http` — é por isso que o `map` abaixo é válido aqui.
#
# **É um `.template`, e não um `.conf`.** A imagem `nginx:alpine` roda
# `/docker-entrypoint.d/20-envsubst-on-templates.sh` no boot, que expande `${VAR}` de
# `/etc/nginx/templates/*.template` para `/etc/nginx/conf.d/`. Só as duas variáveis com chaves
# abaixo são expandidas: as do nginx (`$scheme`, `$host`, `$request_id`…) não têm chaves e não
# são nomes de variável de ambiente, então passam intactas.
#
# Duas coisas eram fixas aqui e **não funcionam no Cloud Run**, que é onde HML roda (ADR 0046 do
# portal do cliente, onde mora o Terraform dos dois):
#
#   - `listen 80`. O Cloud Run entrega a porta na variável PORT e recusa a revisão de um que
#     não atende nela. O Terraform declarava `porta = 8080` para este serviço, e o container
#     escutava na 80: a sonda de inicialização falharia, sempre.
#   - `http://api:8000` com `resolver 127.0.0.11`. Aquele endereço é o DNS interno **do Docker**,
#     que existe na rede do compose e em lugar nenhum fora dela. E o nome `api` é do compose. O
#     Terraform já injetava `API_UPSTREAM` para este contêiner — e este arquivo nunca a leu.

# Preserva o que o proxy de fora disse sobre o esquema e só cai no `$scheme` quando não há ninguém
# na frente. Fixar `https` aqui criaria laço infinito de redirect quando este nginx for o único
# salto; fixar `$scheme` apagaria o https terminado lá fora e o Django redirecionaria para sempre.
map $http_x_forwarded_proto $esquema_de_origem {
    ""      $scheme;
    default $http_x_forwarded_proto;
}

# Identidade da requisição (FDD 020). O `$request_id` do nginx é um hex de 32 caracteres gerado
# por requisição; ele só é usado quando ninguém na frente já mandou um — assim uma requisição que
# atravessa o proxy do provedor, este nginx e o gunicorn carrega **um** id do começo ao fim.
map $http_x_request_id $request_id_de_origem {
    ""      $request_id;
    default $http_x_request_id;
}

# O mesmo id no log da borda: é o que permite ver que a requisição chegou aqui quando ela nunca
# apareceu no log da API (502, timeout, corpo grande demais).
log_format biahflow '$remote_addr "$request" $status $body_bytes_sent '
                    '${request_time}s "$http_user_agent" req=$request_id_de_origem';

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    access_log /dev/stdout biahflow;

    # Espelha o `DATA_UPLOAD_MAX_MEMORY_SIZE` do Django: melhor o 413 do nginx do que o upload
    # subir inteiro para o gunicorn recusar depois.
    client_max_body_size 12m;

    # O Vite carimba hash no nome dos arquivos de `/assets/`, então eles podem ser imutáveis.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # O index não: é ele que aponta para o bundle novo depois de um deploy.
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # Sondas de processo (FDD 020). Precisam de bloco próprio: elas não casam com o regex de
    # `/api|/admin|/static` e cairiam no `try_files` lá embaixo, que responderia o **index.html do
    # SPA com 200** — um balanceador leria "saudável" com a API fora do ar. É o mesmo defeito que
    # o bloco `/media/` documenta adiante, com consequência pior.
    location ~ ^/(healthz|readyz)$ {
        resolver ${DNS_RESOLVER} valid=10s ipv6=off;
        set $upstream_probe ${API_UPSTREAM};
        proxy_pass $upstream_probe;
        # `$proxy_host` e não `$host`: o upstream tem nome próprio (o do serviço no Cloud Run, ou
        # `api` no compose), e mandar o nome público faria o Django recusar por `ALLOWED_HOSTS`.
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Request-ID $request_id_de_origem;
        # Sonda que espera 30 s não é sonda: o balanceador precisa da resposta ruim rápido.
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        access_log off;
    }

    # API, admin e o estático servido pelo WhiteNoise vão para o gunicorn.
    location ~ ^/(api|admin|static)/ {
        # `proxy_pass` com **variável** de propósito: com o host literal, o nginx resolve o nome no
        # boot e **se recusa a iniciar** se o upstream ainda não existe ("host not found in
        # upstream"). Como o compose reinicia containers de forma independente, um restart do `web`
        # enquanto a `api` está fora deixaria o nginx morto até alguém subir na mão. Com variável a
        # resolução é adiada para a requisição, e o pior caso passa a ser um 502 temporário.
        # `DNS_RESOLVER` é `127.0.0.11` no compose (o DNS interno do Docker) e o resolvedor de
        # metadados no Cloud Run, onde aquele endereço não existe.
        resolver ${DNS_RESOLVER} valid=10s ipv6=off;
        set $upstream_api ${API_UPSTREAM};
        proxy_pass $upstream_api;
        proxy_set_header Host $proxy_host;
        # Necessário quando o upstream é https (Cloud Run): sem SNI o handshake é recusado.
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $esquema_de_origem;
        # Sem isto o log do nginx e o do gunicorn falam de requisições que ninguém consegue casar.
        proxy_set_header X-Request-ID $request_id_de_origem;
        proxy_redirect off;
    }

    # Documento é recurso privado e a única porta é `/api/v1/documents/<id>/download/`, com sessão e
    # RBAC (ADR 0002, FDD 017). O Django já não serve `MEDIA_ROOT` em ambiente nenhum, mas sem este
    # bloco o `try_files` abaixo responderia o `index.html` do SPA com **200** — e a FDD 017 diz que
    # `/media/...` responde 404. Não é vazamento, é a resposta errada.
    location /media/ {
        return 404;
    }

    # Rota do SPA: qualquer caminho que não é arquivo cai no index e o React Router resolve.
    location / {
        try_files $uri /index.html;
    }
}
